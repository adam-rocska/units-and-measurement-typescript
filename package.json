{
  "name": "@adam-rocska/units-and-measurement",
  "version": "1.0.1",
  "description": "A TypeScript library for handling units and measurements with support for multiple formats (tuples, objects, strings, dimensions) and operations (arithmetic, comparison). Modular, tree-shakable, and designed for safe, boilerplate-free usage.",
  "keywords": [
    "units",
    "measurement",
    "unit-conversion",
    "numeric-calculations",
    "quantities",
    "unit-aware",
    "type-safe",
    "types",
    "typescript",
    "ts",
    "js",
    "javascript",
    "node",
    "nodejs",
    "math",
    "dimension",
    "scaling",
    "measurement-units",
    "unit-operations",
    "unit-management",
    "arithmetic-operations",
    "comparison",
    "tree-shaking",
    "modular",
    "type predicates",
    "value extraction",
    "boilerplate-free",
    "measurements library"
  ],
  "author": {
    "name": "Ádám László Rocska",
    "url": "https://adam-rocska.github.io"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-rocska/units-and-measurement-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/adam-rocska/units-and-measurement-typescript/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/adam-rocska"
    }
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "clean": "rimraf dist",
    "build": "bunchee",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"eslint.config.mjs\" \"vitest.config.mts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "check": "pnpm lint && pnpm typecheck && npm_config_cache=.npm-cache pnpm attw --pack"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.5",
    "bunchee": "^6.10.0",
    "eslint": "^10.3.0",
    "pnpm": "^11.0.8",
    "rimraf": "^6.1.3",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "files": [
    "dist",
    "operations",
    "length",
    "volume",
    "angle",
    "area",
    "mass",
    "pressure",
    "acceleration",
    "duration",
    "frequency",
    "speed",
    "energy",
    "power",
    "temperature",
    "illuminance",
    "electric-charge",
    "electric-current",
    "electric-potential-difference",
    "electric-resistance",
    "concentration-mass",
    "dispersion",
    "information"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/es/index.d.mts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
